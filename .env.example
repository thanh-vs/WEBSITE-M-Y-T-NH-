# Khoa bi mat tao token dang nhap
JWT_SECRET=your_jwt_secret_key_here

# Cong chay server backend
PORT=3000

# Moi truong chay du an (development hoac production)
NODE_ENV=development

# Duong dan ket noi co so du lieu MongoDB
MONGODB_URI=mongodb://localhost:27017/techcore

# Mat khau khoi tao cho tai khoan quan tri vien (Admin)
DEFAULT_ADMIN_PASSWORD=admin123

# Mat khau khoi tao cho tai khoan nhan vien (Staff)
DEFAULT_STAFF_PASSWORD=staff123
